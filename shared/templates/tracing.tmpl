import (
	"context"

	"go.opentelemetry.io/otel"
	"go.opentelemetry.io/otel/trace"
	otelcodes "go.opentelemetry.io/otel/codes"
)

{{ $decorator := (printf "%sTracingMiddleware" .Interface.Name) }}

// {{$decorator}} реализует интерфейс {{.Interface.Name}} с поддержкой трассировки OpenTelemetry
type {{$decorator}} struct {
	next {{.Interface.Name}}
	tracer trace.Tracer
}

// New{{$decorator}} создает новый экземпляр декоратора для трассировки
func New{{$decorator}}(next {{.Interface.Name}}) {{$decorator}} {
	return {{$decorator}}{
		next:   next,
		tracer: otel.Tracer("{{ (or .Vars.TracerName "usecase-tracer") }}"),
	}
}

{{range $method := .Interface.Methods}}
// {{$method.Name}} трассирует выполнение метода {{$method.Name}}
func (m {{$decorator}}) {{$method.Declaration}} {
	{{if $method.AcceptsContext}}
	ctx, span := m.tracer.Start(ctx, "{{$.Interface.Name}}.{{$method.Name}}")
	{{else}}
	ctx := context.Background()
	ctx, span := m.tracer.Start(ctx, "{{$.Interface.Name}}.{{$method.Name}}")
	{{end}}
	defer span.End()

	{{$method.ResultsNames}} = m.next.{{$method.Call}}

	{{if $method.ReturnsError}}
	if err != nil {
		span.RecordError(err)
		span.SetStatus(otelcodes.Error, err.Error())
	}
	{{end}}
	return
}
{{end}}